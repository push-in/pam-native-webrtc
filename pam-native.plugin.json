{
    "$schema": "vendor/pushinbr/pam-native/resources/pam-native.plugin.schema.json",
    "version": 1,
    "protocol": 1,
    "pamNative": {
        "minimum": "1.0.35",
        "maximumExclusive": "2.0.0"
    },
    "capabilities": {
        "required": [
            "runtime.modules.v1",
            "wire.binary.v1"
        ],
        "optional": []
    },
    "php": {
        "provider": "Pam\\Native\\WebRtc\\WebRtcPluginProvider"
    },
    "android": {
        "namespace": "dev.pam.webrtc",
        "minSdk": 26,
        "permissions": [
            "android.permission.INTERNET",
            "android.permission.ACCESS_NETWORK_STATE",
            "android.permission.CAMERA",
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.WAKE_LOCK",
            "android.permission.VIBRATE"
        ],
        "dependencies": [
            "org.jitsi:webrtc:124.0.0"
        ],
        "sourceDirs": [
            "android/src/main/kotlin"
        ],
        "manifest": "android/src/main/AndroidManifest.xml",
        "consumerRules": "android/consumer-rules.pro"
    },
    "ios": {
        "minimumVersion": "15.0",
        "sourceDirs": [
            "ios/Sources"
        ],
        "swiftPackages": [
            {
                "url": "https://github.com/stasel/WebRTC.git",
                "requirement": {
                    "kind": 2,
                    "value": "124.0.0"
                },
                "products": [
                    "WebRTC"
                ]
            }
        ],
        "frameworks": [
            "AVFoundation",
            "AudioToolbox"
        ],
        "usageDescriptions": {
            "NSCameraUsageDescription": "Share your camera during video calls.",
            "NSMicrophoneUsageDescription": "Talk during voice and video calls."
        },
        "infoPlist": "ios/Info.plist"
    },
    "idl": "pam-native.idl.json",
    "modules": [
        {
            "name": "webrtc",
            "class": "dev.pam.webrtc.WebRtcModule",
            "iosClass": "WebRtcModule"
        },
        {
            "name": "call-audio",
            "class": "dev.pam.webrtc.CallAudioModule",
            "iosClass": "CallAudioModule"
        }
    ],
    "views": [
        {
            "name": "webrtc.video",
            "class": "dev.pam.webrtc.RtcVideoViewFactory",
            "iosClass": "RtcVideoViewFactory"
        }
    ]
}
