{
    "name": "pushinbr/pam-native-webrtc",
    "description": "Native WebRTC peer connections, GPU video rendering and call audio routing for PAM Native.",
    "type": "pam-native-plugin",
    "keywords": ["pam-native", "webrtc", "video-call", "voice-call", "android", "ios"],
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "pushinbr/pam-native": "^1.0.35"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Native\\WebRtc\\": "src/"
        }
    },
    "extra": {
        "pam-native": {
            "plugin": "pam-native.plugin.json"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
